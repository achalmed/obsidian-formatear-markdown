{
  "name": "obsidian-formatear-markdown",
  "version": "0.1.2",
  "description": "Complemento de Obsidian: formatea y corrige Markdown con Prettier y markdownlint, sin romper la sintaxis de Obsidian.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --vigilar",
    "test": "node --test prueba/*.test.js"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "markdown",
    "prettier",
    "markdownlint"
  ],
  "author": "achalmed",
  "license": "MIT",
  "dependencies": {
    "markdownlint": "0.42.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
